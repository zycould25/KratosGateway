# Copy to .env and replace every CHANGE_ME value. Keep the file private.
DATA_ROOT=C:/KratosData
LAN_IP=192.168.1.10
LAN_TOKEN=CHANGE_ME_WITH_A_RANDOM_32_CHARACTER_SECRET
NODE_ID=storage-1
REPLICA_COUNT=1
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PROBE_PASSWORD=CHANGE_ME_POSTGRES_PROBE_PASSWORD
REPLICATION_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD
REPLICATION_CIDR=192.168.1.0/24
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Stable gateway names: registry/files/s3/console.<GATEWAY_DOMAIN>
GATEWAY_DOMAIN=kratos.internal
GATEWAY_HTTP_ENTRYPOINT=web
GATEWAY_POSTGRES_ENTRYPOINT=postgres
GATEWAY_MINIO_NODE_ID=storage-1
GATEWAY_TLS=false
# For an existing HTTPS gateway: set TLS=true and HTTP_ENTRYPOINT=websecure.
# GATEWAY_CERT_RESOLVER=your-existing-resolver
# Optional override, reachable from Traefik; defaults to http://<LAN_IP>:8080.
# GATEWAY_HUB_URL=http://192.168.1.10:8080
GATEWAY_HTTP_PORT=8088
GATEWAY_POSTGRES_PORT=15432
